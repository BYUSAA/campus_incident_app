rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verifiedAlu() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function staff() {
      return verifiedAlu()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /incident_photos/{uid}/{fileName} {
      // Report owners and staff can view uploaded evidence.
      allow read: if verifiedAlu()
        && (request.auth.uid == uid || staff());

      allow create, update: if verifiedAlu()
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if verifiedAlu() && request.auth.uid == uid;
    }
  }
}
