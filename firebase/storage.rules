rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verifiedAlu() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function staff() {
      return verifiedAlu()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function canReadOrDelete(uid) {
      return verifiedAlu() && (request.auth.uid == uid || staff());
    }

    match /incident_photos/{uid}/{fileName} {
      allow read: if canReadOrDelete(uid);

      allow create, update: if verifiedAlu()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');

      // Staff need delete permission so they can moderate a report and clean
      // up its photo after deleting its Firestore document.
      allow delete: if canReadOrDelete(uid);
    }
  }
}