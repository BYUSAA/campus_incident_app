rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function verifiedAlu(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.matches('.*@alustudent[.]com$');}
  match /incident_photos/{uid}/{fileName} {
   allow read: if verifiedAlu();
   allow write: if verifiedAlu() && request.auth.uid == uid && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
  }
 }
}
