rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function aluAccount() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function verifiedAlu() {
      return aluAccount() && request.auth.token.email_verified == true;
    }

    function staff() {
      return verifiedAlu()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function validUserName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }

    function validIncidentContent(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 1000
        && data.category in [
          'Facilities', 'Water', 'Electricity', 'Safety', 'Sanitation'
        ]
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 160
        && (!('reporterName' in data) || validUserName(data.reporterName))
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string)
        && (!('photoUrls' in data)
          || (data.photoUrls is list && data.photoUrls.size() <= 1))
        && (!('assignedTo' in data)
          || data.assignedTo == null || data.assignedTo is string);
    }

    function validStatus(status) {
      return status in ['Submitted', 'In Progress', 'Resolved'];
    }

    function validForwardStatusTransition() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'Submitted'
          && request.resource.data.status == 'In Progress')
        || (resource.data.status == 'In Progress'
          && request.resource.data.status == 'Resolved');
    }

    match /users/{uid} {
      // New ALU accounts can create their own student profile before email
      // verification. Incident operations still require a verified account.
      allow create: if aluAccount()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validUserName(request.resource.data.name)
        && request.resource.data.role == 'student'
        && request.resource.data.emailVerified == false
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'emailVerified', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'emailVerified', 'createdAt'
        ]);

      // A user can read only their own profile. Staff role checks use
      // server-side rule lookups and do not need collection-wide profile reads.
      allow read: if aluAccount() && request.auth.uid == uid;

      // A client may edit the display name, but cannot change role, email,
      // verification metadata, or any other protected profile fields.
      allow update: if aluAccount()
        && request.auth.uid == uid
        && validUserName(request.resource.data.name)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.emailVerified == resource.data.emailVerified
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt'])
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt == request.time);

      allow delete: if false;
    }

    match /incidents/{incidentId} {
      // Students can only read their own reports; authorized staff can review
      // the incident queue. Student list queries must filter by reportedBy.
      allow read: if staff()
        || (verifiedAlu() && resource.data.reportedBy == request.auth.uid);

      allow create: if verifiedAlu()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'Submitted'
        && validIncidentContent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'location', 'reportedBy',
          'reporterName', 'status', 'createdAt', 'updatedAt',
          'imageUrl', 'photoUrls', 'assignedTo'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'location', 'reportedBy',
          'status', 'createdAt', 'updatedAt'
        ]);

      // Staff can move an incident forward through the workflow and update
      // assignment metadata. Students can edit content only while it remains
      // Submitted; the status and ownership are immutable for student writes.
      allow update: if (
        staff()
        && request.resource.data.reportedBy == resource.data.reportedBy
        && validIncidentContent(request.resource.data)
        && validStatus(request.resource.data.status)
        && validForwardStatusTransition()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'assignedTo'])
      ) || (
        verifiedAlu()
        && resource.data.reportedBy == request.auth.uid
        && resource.data.status == 'Submitted'
        && request.resource.data.reportedBy == resource.data.reportedBy
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reporterName == resource.data.reporterName
        && validIncidentContent(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'title', 'description', 'category', 'location',
            'imageUrl', 'photoUrls', 'updatedAt'
          ])
      );

      // Students may remove their own unprocessed submissions. Staff can
      // remove a report at any stage and clean up the associated evidence.
      allow delete: if staff()
        || (verifiedAlu()
          && resource.data.reportedBy == request.auth.uid
          && resource.data.status == 'Submitted');
    }
  }
}
