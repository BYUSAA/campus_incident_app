rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function aluAccount() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function verifiedAlu() {
      return aluAccount() && request.auth.token.email_verified == true;
    }

    function staff() {
      return verifiedAlu()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function validIncidentContent(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 1000
        && data.category in ['Facilities', 'Water', 'Electricity', 'Safety', 'Sanitation']
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 160;
    }

    match /users/{uid} {
      // A newly created ALU account may create its own student profile before
      // verifying email. All incident access still requires email verification.
      allow create: if aluAccount()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.emailVerified == false
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'emailVerified', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'emailVerified', 'createdAt'
        ]);

      allow read: if aluAccount()
        && (request.auth.uid == uid || staff());

      // Users cannot change their own role or verification status. Staff roles
      // must be granted through a trusted Firebase Console/Admin SDK process.
      allow update: if aluAccount()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt']);

      allow delete: if false;
    }

    match /incidents/{incidentId} {
      // Students may only read their own reports; authorized staff may review
      // all reports. Query filters must match these rules.
      allow read: if staff()
        || (verifiedAlu() && resource.data.reportedBy == request.auth.uid);

      allow create: if verifiedAlu()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'Submitted'
        && validIncidentContent(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'location', 'reportedBy',
          'reporterName', 'status', 'createdAt', 'updatedAt',
          'imageUrl', 'photoUrls', 'assignedTo'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'location', 'reportedBy',
          'status', 'createdAt', 'updatedAt'
        ]);

      // Staff can moderate status/assignment. Students can only edit the
      // content of their own reports while the report is still Submitted.
      // This restriction is enforced here as well as in the user interface.
      allow update: if (
        staff()
        && request.resource.data.reportedBy == resource.data.reportedBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'assignedTo'])
        && request.resource.data.status in ['Submitted', 'In Progress', 'Resolved']
      ) || (
        verifiedAlu()
        && resource.data.reportedBy == request.auth.uid
        && resource.data.status == 'Submitted'
        && request.resource.data.reportedBy == resource.data.reportedBy
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && validIncidentContent(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'title', 'description', 'category', 'location',
            'reporterName', 'imageUrl', 'photoUrls', 'updatedAt'
          ])
      );

      allow delete: if staff()
        || (verifiedAlu() && resource.data.reportedBy == request.auth.uid);
    }
  }
}